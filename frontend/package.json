{
  "name": "invasor-frontend",
  "version": "0.3.0-rc1",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --external:jsdom --platform=node --format=esm --outdir=test/.out --out-extension:.js=.mjs --log-level=warning && node --test test/.out/*.test.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0"
  }
}
