{
  "api": 1,
  "min_core": "0.1.0",
  "name": "Demo",
  "version": "0.2.0",
  "author": "FranjeGueje",
  "description": "Showcase of everything the core offers modules: settings and their rules, forms, controls, sub-tabs, windows, backend, notifications.",
  "order": 10,
  "tab": "Demo",
  "settings": [
    {
      "section": "Basics",
      "items": [
        { "key": "enabled", "type": "toggle", "label": "Enabled", "default": true },
        { "key": "hdr", "type": "checkbox", "label": "HDR", "default": false }
      ]
    },
    {
      "section": "Values",
      "items": [
        { "key": "volume", "type": "slider", "label": "Volume", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "key": "fps", "type": "number", "label": "FPS limit", "min": 15, "max": 144, "step": 5, "default": 60, "hint": "the game's frame cap" }
      ]
    },
    {
      "section": "Choices",
      "items": [
        {
          "key": "mode", "type": "radio", "label": "Mode", "default": "balanced",
          "options": [
            { "value": "eco", "label": "Eco" },
            { "value": "balanced", "label": "Balanced" },
            { "value": "turbo", "label": "Turbo" }
          ]
        },
        {
          "key": "quality", "type": "select", "label": "Quality", "default": "medium",
          "options": [
            { "value": "low", "label": "Low" },
            { "value": "medium", "label": "Medium" },
            { "value": "high", "label": "High" },
            { "value": "ultra", "label": "Ultra" },
            { "value": "custom", "label": "Custom" }
          ]
        }
      ]
    },
    { "key": "name", "type": "text", "label": "Name", "default": "", "max_length": 32, "placeholder": "type…" },
    { "key": "secret", "type": "password", "label": "Secret", "default": "", "max_length": 32, "placeholder": "type…", "hint": "Masked like an API key; stored as is" },
    {
      "section": "Preset",
      "items": [
        {
          "key": "preset", "type": "radio", "label": "Preset", "default": "custom",
          "hint": "Quiet and Max set the fan (the backend does it)",
          "options": [
            { "value": "custom", "label": "Custom" },
            { "value": "quiet", "label": "Quiet" },
            { "value": "max", "label": "Max" }
          ]
        },
        {
          "key": "fan", "type": "slider", "label": "Fan", "min": 0, "max": 100, "step": 10, "unit": "%", "default": 50,
          "disabled_when": { "preset": ["quiet", "max"] }
        }
      ]
    },
    {
      "section": "Frame generation",
      "items": [
        { "key": "adaptive", "type": "toggle", "label": "Adaptive", "default": false },
        { "key": "multiplier", "type": "number", "label": "Multiplier", "min": 2, "max": 4, "default": 2, "when": { "adaptive": false } }
      ]
    },
    {
      "section": "Adaptive", "open": false, "when": { "adaptive": true },
      "items": [
        { "key": "target", "type": "slider", "label": "Target", "min": 30, "max": 120, "step": 10, "unit": " fps", "default": 60 }
      ]
    },
    {
      "section": "Notifications",
      "items": [
        { "key": "notify_preset", "type": "toggle", "label": "Notify presets", "default": false, "hint": "shown as Steam shows an achievement" },
        {
          "key": "notify_text", "type": "text", "label": "Message", "default": "Preset applied", "max_length": 64,
          "when": { "notify_preset": true, "preset": ["quiet", "max"] }
        }
      ]
    }
  ],
  "forms": {
    "profile": [
      { "key": "label", "type": "text", "label": "Profile name", "default": "default", "max_length": 32 },
      { "key": "scale", "type": "slider", "label": "Scale", "min": 0.25, "max": 1, "step": 0.05, "default": 0.8 },
      { "key": "vsync", "type": "toggle", "label": "VSync", "default": true },
      {
        "key": "pacing", "type": "select", "label": "Pacing", "default": "auto",
        "options": [
          { "value": "auto", "label": "Auto" },
          { "value": "low", "label": "Low latency" },
          { "value": "smooth", "label": "Smooth" }
        ],
        "disabled_when": { "vsync": false }
      }
    ]
  }
}
